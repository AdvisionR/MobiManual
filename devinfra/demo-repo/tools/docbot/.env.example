# Settings for running DocBot on a laptop. Copy to .env, which is gitignored,
# and fill in:
#
#   cp .env.example .env
#   uv run --env-file .env docbot update-manual --sha <merge commit> --dry-run
#
# Variables already exported in the shell take precedence over this file.
# In CI nothing comes from a file: the Jenkinsfile sets the DOCBOT_* settings
# and binds the secrets from Jenkins credentials.

# GitLab. These values are for the local devinfra stack.
DOCBOT_GITLAB_URL=http://gitlab.orb.local
DOCBOT_PROJECT=root/mobivisor-console
# For the local stack, the token is in the MobiManual repository at
# devinfra/.runtime/gitlab.env, as GITLAB_PAT.
DOCBOT_GITLAB_TOKEN=

# Model provider. Read by triage and drafting.
MISTRAL_API_KEY=
DOCBOT_LLM_MODEL=mistral-medium-3-5
