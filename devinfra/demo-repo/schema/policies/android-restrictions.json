{
  "_comment": [
    "Android restrictions: the settings of a Restrictions policy. The console",
    "builds the form from this file, and scripts/render-restrictions.js renders",
    "the table on public/doc/<lang>/_policies_restrictions.md from it. Change a",
    "setting here, then re-run the script."
  ],
  "platform": "android-enterprise",
  "settings": [
    { "key": "camera_enabled", "type": "boolean", "default": true,
      "label": "Allow camera", "applies_to": ["fully-managed", "work-profile"] },
    { "key": "screen_capture_enabled", "type": "boolean", "default": true,
      "label": "Allow screen capture", "applies_to": ["fully-managed", "work-profile"] },
    { "key": "bluetooth_enabled", "type": "boolean", "default": true,
      "label": "Allow Bluetooth", "applies_to": ["fully-managed"] },
    { "key": "usb_file_transfer_enabled", "type": "boolean", "default": false,
      "label": "Allow USB file transfer", "applies_to": ["fully-managed"] },
    { "key": "unknown_sources_enabled", "type": "boolean", "default": false,
      "label": "Allow apps from unknown sources", "applies_to": ["fully-managed", "work-profile"] },
    { "key": "factory_reset_enabled", "type": "boolean", "default": false,
      "label": "Allow factory reset", "applies_to": ["fully-managed"] }
  ]
}
