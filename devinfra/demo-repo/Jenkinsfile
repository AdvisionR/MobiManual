// Runs docbot once a merge request has landed on main. docbot works out which
// merge request that was from the commit under build; this file only decides
// when to run it.

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    GITLAB_URL     = 'http://gitlab.orb.local'
    GITLAB_PROJECT = 'root/mobivisor-console'
  }

  stages {
    stage('DocBot') {
      when { 
        branch 'main'
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'gitlab-http',
                                          usernameVariable: 'GITLAB_USER',
                                          passwordVariable: 'GITLAB_TOKEN')]) {
          sh 'docbot'
        }
        archiveArtifacts artifacts: 'detection.json,mr.json',
                         fingerprint: true, allowEmptyArchive: true
      }
    }
  }
}
