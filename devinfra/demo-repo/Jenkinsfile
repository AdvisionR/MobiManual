// Runs DocBot once a merge request has landed on main. DocBot works out which
// merge request that was from the commit under build; this file only decides
// when to run it, and installs it. See tools/docbot/README.md.

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
  }

  environment {
    DOCBOT_GITLAB_URL = 'http://gitlab.orb.local'
    DOCBOT_PROJECT    = 'root/mobivisor-console'
  }

  stages {
    stage('DocBot') {
      when {
        branch 'main'
      }
      steps {
        // The venv lives in the workspace, which Jenkins keeps between builds,
        // so PyPI is only needed when requirements.txt changes.
        sh '''
          test -x tools/docbot/.venv/bin/python || python3 -m venv tools/docbot/.venv
          tools/docbot/.venv/bin/pip install --quiet --require-hashes -r tools/docbot/requirements.txt
        '''
        withCredentials([string(credentialsId: 'docbot-gitlab-token', variable: 'DOCBOT_GITLAB_TOKEN')]) {
          sh 'PYTHONPATH=tools/docbot/src tools/docbot/.venv/bin/python -m docbot update-manual > result.json'
        }
      }
      post {
        always {
          archiveArtifacts artifacts: 'result.json', allowEmptyArchive: true
        }
      }
    }
  }
}
