# MobiManual DocBot — local prototype infrastructure
# Every container, volume and network created by this stack is prefixed with
# COMPOSE_PROJECT_NAME, which is what makes the teardown exhaustive and safe.
COMPOSE_PROJECT_NAME=mobimanual

# --- Image pins -------------------------------------------------------------
# Pinned deliberately: "latest" would silently change GitLab major versions
# between prototype runs and break the Jenkins plugin compatibility matrix.
GITLAB_VERSION=19.2.2-ce.0
JENKINS_BASE_VERSION=lts-jdk21

# --- Hostnames --------------------------------------------------------------
# OrbStack publishes <container_name>.orb.local and resolves it BOTH from macOS
# and from inside other containers, to the same reachable address. That is why
# this stack needs no /etc/hosts entries, no sudo, and no published ports:
# one URL is correct for your browser, for Jenkins, and for GitLab webhooks.
GITLAB_HOST=gitlab.orb.local
JENKINS_HOST=jenkins.orb.local
JENKINS_PORT=8080

# --- Credentials (local prototype only — never reuse these anywhere) --------
GITLAB_ROOT_PASSWORD=MobiManualDev!2026
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=MobiManualDev!2026
