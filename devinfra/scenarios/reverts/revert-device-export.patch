From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fixture Developer <dev@mobimanual.local>
Date: Mon, 12 Oct 2026 17:20:00 +0200
Subject: [PATCH] Revert "Export the device list as CSV"

This reverts commit 8c1e2f4a9b3d70e5a6f1c2b4d8e9f0a1b2c3d4e5.

Times out for tenants with large device lists, see MV-2333.
---
Expected: worth documenting. Triage answers doc-impact: a revert removes what the reverted commit added, here the device list's **Export CSV** button. The draft removes "**Export CSV** downloads the list as it is currently filtered." from _devices.md, and does not leave the "Exporting the list" heading over the one sentence that remains there. That sentence, "Selecting a device's name opens its detail page.", is still true and stays on the page. **Export CSV** on _auditlog.md is the Audit Log's own button and stays.
Expected-outcome: opened
Expected-edits: _devices.md

 public/app/devices/devices.controller.js | 4 ----
 public/app/devices/devices.html          | 1 -
 public/app/services/device.service.js    | 3 +--
 3 files changed, 1 insertion(+), 7 deletions(-)

diff --git a/public/app/devices/devices.controller.js b/public/app/devices/devices.controller.js
index f9c4842..084a0dc 100644
--- a/public/app/devices/devices.controller.js
+++ b/public/app/devices/devices.controller.js
@@ -26,9 +26,5 @@ angular.module('mobivisor').controller('DevicesCtrl', ['$scope', 'deviceService'
     return commandService.send(selectedIds(), command).then($scope.reload);
   };
 
-  $scope.exportCsv = function () {
-    return deviceService.exportCsv($scope.filter);
-  };
-
   $scope.reload();
 }]);
diff --git a/public/app/devices/devices.html b/public/app/devices/devices.html
index 138491e..7b11153 100644
--- a/public/app/devices/devices.html
+++ b/public/app/devices/devices.html
@@ -10,7 +10,6 @@
     </label>
     <label><input type="checkbox" ng-model="filter.enrolled" ng-change="reload()"> {{ 'DEVICES.FILTER_ENROLLED' | translate }}</label>
     <input type="search" ng-model="filter.search" ng-change="reload()" placeholder="{{ 'DEVICES.SEARCH_HINT' | translate }}">
-    <button ng-click="exportCsv()">{{ 'COMMON.EXPORT_CSV' | translate }}</button>
   </div>
 
   <div class="toolbar">
diff --git a/public/app/services/device.service.js b/public/app/services/device.service.js
index b020c73..769044e 100644
--- a/public/app/services/device.service.js
+++ b/public/app/services/device.service.js
@@ -4,7 +4,6 @@ angular.module('mobivisor').factory('deviceService', ['api', function (api) {
     list: function (filter) { return api.get('/devices', filter); },
     get: function (id) { return api.get('/devices/' + id); },
     moveToGroup: function (ids, groupId) { return api.post('/devices/move', { ids: ids, group: groupId }); },
-    setDepartment: function (id, departmentId) { return api.put('/devices/' + id + '/department', { department: departmentId }); },
-    exportCsv: function (filter) { return api.get('/devices/export.csv', filter); }
+    setDepartment: function (id, departmentId) { return api.put('/devices/' + id + '/department', { department: departmentId }); }
   };
 }]);
