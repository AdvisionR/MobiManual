From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fixture Developer <dev@mobimanual.local>
Date: Thu, 24 Sep 2026 12:00:00 +0200
Subject: [PATCH] Assign iOS devices to a department during enrollment

Devices enrolled through Apple Business Manager arrived without a
department, and an administrator had to move each one by hand afterwards.

The iOS enrollment wizard now asks which department the device belongs to.
Finish stays disabled until a department is chosen, and the department is
sent along with the enrollment profile.
---
Expected: worth documenting. Triage answers doc-impact. The draft edits _enrollment_ios.md: a step for choosing the **Department** before Finish, and that Finish needs one. _devices_id.md, which says departments come from the directory and can be edited, may stay unchanged or gain that iOS devices get theirs at enrollment; nothing else changes. tr and de are translation debt.
Expected-outcome: opened
Expected-edits: _enrollment_ios.md
Expected-may-edit: _devices_id.md

 .../enrollment/ios/enrollment-wizard.controller.js   | 12 ++++++++++--
 public/app/enrollment/ios/enrollment-wizard.html     |  4 +++-
 public/i18n/de.json                                  |  3 ++-
 public/i18n/en.json                                  |  3 ++-
 public/i18n/tr.json                                  |  3 ++-
 5 files changed, 19 insertions(+), 6 deletions(-)

diff --git a/public/app/enrollment/ios/enrollment-wizard.controller.js b/public/app/enrollment/ios/enrollment-wizard.controller.js
index 35cd65f..c5b2259 100644
--- a/public/app/enrollment/ios/enrollment-wizard.controller.js
+++ b/public/app/enrollment/ios/enrollment-wizard.controller.js
@@ -1,15 +1,23 @@
-angular.module('mobivisor').controller('EnrollmentWizardCtrl', ['$scope', 'depService', 'groupService', function ($scope, depService, groupService) {
+angular.module('mobivisor').controller('EnrollmentWizardCtrl', ['$scope', 'depService', 'groupService', 'departmentService', function ($scope, depService, groupService, departmentService) {
   $scope.step = 1;
-  $scope.profile = { supervised: true, mdmRemovable: false, group: null };
+  $scope.profile = { supervised: true, mdmRemovable: false, group: null, department: null };
 
   groupService.list().then(function (groups) {
     $scope.groups = groups;
   });
 
+  departmentService.list().then(function (departments) {
+    $scope.departments = departments;
+  });
+
   $scope.next = function () {
     $scope.step += 1;
   };
 
+  $scope.canFinish = function () {
+    return $scope.profile.department !== null;
+  };
+
   $scope.finish = function () {
     return depService.assignProfile($scope.profile);
   };
diff --git a/public/app/enrollment/ios/enrollment-wizard.html b/public/app/enrollment/ios/enrollment-wizard.html
index 12e0822..7dc37ff 100644
--- a/public/app/enrollment/ios/enrollment-wizard.html
+++ b/public/app/enrollment/ios/enrollment-wizard.html
@@ -13,9 +13,11 @@
   <div ng-if="step === 3">
     <label for="group">{{ 'ENROLLMENT.GROUP' | translate }}</label>
     <select id="group" ng-model="profile.group" ng-options="g.id as g.name for g in groups"></select>
+    <label for="department">{{ 'ENROLLMENT.DEPARTMENT' | translate }}</label>
+    <select id="department" ng-model="profile.department" ng-options="d.id as d.name for d in departments" required></select>
   </div>
 
   <button ng-if="step > 1" ng-click="step = step - 1">{{ 'COMMON.BACK' | translate }}</button>
   <button ng-if="step < 3" ng-click="next()">{{ 'COMMON.NEXT' | translate }}</button>
-  <button ng-if="step === 3" ng-click="finish()">{{ 'ENROLLMENT.FINISH' | translate }}</button>
+  <button ng-if="step === 3" ng-click="finish()" ng-disabled="!canFinish()">{{ 'ENROLLMENT.FINISH' | translate }}</button>
 </div>
