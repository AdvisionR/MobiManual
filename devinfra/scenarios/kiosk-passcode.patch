diff --git a/server/policies/kiosk.js b/server/policies/kiosk.js
index 2757ae8..a35d960 100644
--- a/server/policies/kiosk.js
+++ b/server/policies/kiosk.js
@@ -1,5 +1,5 @@
 // Kiosk policies. multi-app needs Android; single-app on iOS needs a
-// supervised device. Leaving kiosk mode on the device takes the device passcode.
+// supervised device. Leaving kiosk mode on the device takes the policy's exit passcode.
 
 const MODES = ['single-app', 'multi-app'];
 
@@ -8,4 +8,8 @@ function supports(policy, device) {
   return device.platform === 'android' || device.supervised;
 }
 
-module.exports = { MODES, supports };
+function validate(policy) {
+  return typeof policy.exitPasscode === 'string' && policy.exitPasscode.length >= 4 ? [] : ['exitPasscode'];
+}
+
+module.exports = { MODES, supports, validate };
