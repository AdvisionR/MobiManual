 public/app/policies/kiosk/kiosk.html          | 4 ++++
 public/i18n/de.json                           | 4 +++-
 public/i18n/en.json                           | 4 +++-
 public/i18n/tr.json                           | 4 +++-
 server/policies/kiosk.js                      | 8 ++++++--
 6 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/public/app/policies/kiosk/kiosk.controller.js b/public/app/policies/kiosk/kiosk.controller.js
index 392b43c..01f5cf6 100644
--- a/public/app/policies/kiosk/kiosk.controller.js
+++ b/public/app/policies/kiosk/kiosk.controller.js
@@ -1,6 +1,7 @@
 angular.module('mobivisor').controller('KioskCtrl', ['$scope', 'policyService', function ($scope, policyService) {
   $scope.mode = 'single-app';
   $scope.allowedApps = [];
+  $scope.exitPasscode = '';
 
   $scope.addApp = function (app) {
     if ($scope.mode === 'single-app') {
@@ -11,6 +12,10 @@ angular.module('mobivisor').controller('KioskCtrl', ['$scope', 'policyService',
   };
 
   $scope.save = function () {
-    return policyService.saveKiosk({ mode: $scope.mode, allowedApps: $scope.allowedApps });
+    return policyService.saveKiosk({
+      mode: $scope.mode,
+      allowedApps: $scope.allowedApps,
+      exitPasscode: $scope.exitPasscode
+    });
   };
 }]);
diff --git a/public/app/policies/kiosk/kiosk.html b/public/app/policies/kiosk/kiosk.html
