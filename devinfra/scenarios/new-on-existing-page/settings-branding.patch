diff --git a/server/settings/branding.js b/server/settings/branding.js
new file mode 100644
index 0000000..9607bd9
--- /dev/null
+++ b/server/settings/branding.js
@@ -0,0 +1,15 @@
+// The company logo shown in the console's top bar and on the sign-in page in
+// place of the MobiVisor logo. /branding/logo serves it, or the MobiVisor logo
+// when none is set.
+
+const TYPES = ['image/png', 'image/svg+xml'];
+const MAX_BYTES = 1024 * 1024;
+
+function check(file) {
+  const problems = [];
+  if (TYPES.indexOf(file.type) < 0) problems.push('type');
+  if (file.size > MAX_BYTES) problems.push('size');
+  return problems;
+}
+
+module.exports = { check, TYPES, MAX_BYTES };
