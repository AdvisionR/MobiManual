diff --git a/public/app/settings/settings.controller.js b/public/app/settings/settings.controller.js
index 858b0b0..7754be5 100644
--- a/public/app/settings/settings.controller.js
+++ b/public/app/settings/settings.controller.js
@@ -19,6 +19,18 @@ angular.module('mobivisor').controller('SettingsCtrl', ['$scope', 'api', functio
     });
   };
 
+  $scope.uploadLogo = function (file) {
+    return api.post('/settings/branding/logo', file).then(function (branding) {
+      $scope.settings.branding = branding;
+    });
+  };
+
+  $scope.removeLogo = function () {
+    return api.delete('/settings/branding/logo').then(function () {
+      $scope.settings.branding = {};
+    });
+  };
+
   $scope.save = function (section) {
     return api.put('/settings/' + section, $scope.settings[section]);
   };
