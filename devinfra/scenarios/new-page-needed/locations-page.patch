--- a/server/protocol/android/checkin.js
+++ b/server/protocol/android/checkin.js
@@ -7,4 +7,6 @@ function schedule(device) {
   return { device: device.id, everyMinutes: CHECKIN_INTERVAL_MINUTES };
 }
 
+// A check-in may carry { latitude, longitude, accuracy }; see devices/locations.js.
+
 module.exports = { schedule, CHECKIN_INTERVAL_MINUTES };
