diff --git a/public/app/locations/locations.controller.js b/public/app/locations/locations.controller.js
new file mode 100644
index 0000000..6951e7e
--- /dev/null
+++ b/public/app/locations/locations.controller.js
@@ -0,0 +1,11 @@
+angular.module('mobivisor').controller('LocationsCtrl', ['$scope', '$location', 'locationService', function ($scope, $location, locationService) {
+  $scope.positions = [];
+
+  locationService.latest().then(function (positions) {
+    $scope.positions = positions;
+  });
+
+  $scope.open = function (device) {
+    $location.path('/devices/' + device.id);
+  };
+}]);
diff --git a/public/app/locations/locations.html b/public/app/locations/locations.html
new file mode 100644
index 0000000..584a5d2
--- /dev/null
+++ b/public/app/locations/locations.html
@@ -0,0 +1,19 @@
+<!-- #!/locations, LocationsCtrl. Administrators only (server/auth/permissions.js). -->
+<div class="locations">
+  <h1>{{ 'LOCATIONS.TITLE' | translate }}</h1>
+  <p class="hint">{{ 'LOCATIONS.HINT' | translate }}</p>
+  <div class="map" device-map="positions" on-select="open(device)"></div>
+  <table>
+    <tr>
+      <th>{{ 'DEVICES.COL_NAME' | translate }}</th>
+      <th>{{ 'DEVICES.COL_OWNER' | translate }}</th>
+      <th>{{ 'LOCATIONS.REPORTED' | translate }}</th>
+    </tr>
+    <tr ng-repeat="p in positions">
+      <td><a href="#!/devices/{{ p.device.id }}">{{ p.device.name }}</a></td>
+      <td>{{ p.device.owner }}</td>
+      <td>{{ p.reportedAt | date:'short' }}</td>
+    </tr>
+  </table>
+  <p ng-if="!positions.length">{{ 'LOCATIONS.NONE' | translate }}</p>
+</div>
