diff --git a/server/devices/locations.js b/server/devices/locations.js
new file mode 100644
index 0000000..4eb5aed
--- /dev/null
+++ b/server/devices/locations.js
@@ -0,0 +1,16 @@
+// Last known positions. Devices send a position with each check-in when the
+// user has granted the agent the location permission. Older positions are
+// not shown.
+
+const MAX_AGE_DAYS = 30;
+
+function latest(db, now) {
+  const since = new Date(now.getTime() - MAX_AGE_DAYS * 24 * 60 * 60 * 1000);
+  return db.positions.aggregate([
+    { $match: { reportedAt: { $gte: since } } },
+    { $sort: { reportedAt: -1 } },
+    { $group: { _id: '$device', position: { $first: '$$ROOT' } } }
+  ]);
+}
+
+module.exports = { latest, MAX_AGE_DAYS };
