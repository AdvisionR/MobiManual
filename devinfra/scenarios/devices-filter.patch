diff --git a/server/devices/query.js b/server/devices/query.js
index 4120587..8b58d32 100644
--- a/server/devices/query.js
+++ b/server/devices/query.js
@@ -8,6 +8,9 @@ function where(filter) {
   if (filter.enrolled) {
     clause.status = { $nin: ['wiped', 'retired'] };
   }
+  if (filter.compliance && filter.compliance !== 'all') {
+    clause.compliant = filter.compliance === 'compliant';
+  }
   if (filter.search) {
     const pattern = new RegExp(filter.search.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'i');
     clause.$or = [{ name: pattern }, { serial: pattern }, { owner: pattern }];
