From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fixture Developer <dev@mobimanual.local>
Date: Thu, 24 Sep 2026 12:00:00 +0200
Subject: [PATCH] Filter the device list by compliance

Administrators want to find the devices that break their policies without
opening each one.

The device list gets a compliance filter next to the platform filter, with
the choices all, compliant and non-compliant. The device service already
knew each device's compliance state; the list now asks for it.
---
Expected: worth documenting. Triage answers doc-impact. The draft adds the **Compliance** filter to "Filtering the list" on _devices.md. _devices_id.md, _dashboard.md and _policies.md also mention compliance and stay unchanged.
Expected-outcome: opened
Expected-edits: _devices.md

 public/app/devices/devices.controller.js | 2 +-
 public/app/devices/devices.html          | 7 +++++++
 public/app/services/device.service.js    | 3 ++-
 public/i18n/de.json                      | 1 +
 public/i18n/en.json                      | 1 +
 public/i18n/tr.json                      | 1 +
 server/devices/query.js                  | 3 +++
 7 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/public/app/devices/devices.controller.js b/public/app/devices/devices.controller.js
index f9c4842..ee2a9f6 100644
--- a/public/app/devices/devices.controller.js
+++ b/public/app/devices/devices.controller.js
@@ -1,6 +1,6 @@
 angular.module('mobivisor').controller('DevicesCtrl', ['$scope', 'deviceService', 'groupService', 'commandService', function ($scope, deviceService, groupService, commandService) {
   $scope.devices = [];
-  $scope.filter = { platform: 'all', enrolled: true };
+  $scope.filter = { platform: 'all', enrolled: true, compliance: 'all' };
   $scope.selected = {};
 
   $scope.reload = function () {
diff --git a/public/app/devices/devices.html b/public/app/devices/devices.html
index 138491e..16c8552 100644
--- a/public/app/devices/devices.html
+++ b/public/app/devices/devices.html
@@ -8,6 +8,13 @@
         <option value="ios">iOS</option>
       </select>
     </label>
+    <label>{{ 'DEVICES.FILTER_COMPLIANCE' | translate }}
+      <select ng-model="filter.compliance" ng-change="reload()">
+        <option value="all">{{ 'COMMON.ALL' | translate }}</option>
+        <option value="compliant">{{ 'DEVICES.COMPLIANT' | translate }}</option>
+        <option value="non-compliant">{{ 'DEVICES.NON_COMPLIANT' | translate }}</option>
+      </select>
+    </label>
     <label><input type="checkbox" ng-model="filter.enrolled" ng-change="reload()"> {{ 'DEVICES.FILTER_ENROLLED' | translate }}</label>
     <input type="search" ng-model="filter.search" ng-change="reload()" placeholder="{{ 'DEVICES.SEARCH_HINT' | translate }}">
     <button ng-click="exportCsv()">{{ 'COMMON.EXPORT_CSV' | translate }}</button>
diff --git a/public/app/services/device.service.js b/public/app/services/device.service.js
index b020c73..d5c4770 100644
--- a/public/app/services/device.service.js
+++ b/public/app/services/device.service.js
@@ -1,6 +1,7 @@
 angular.module('mobivisor').factory('deviceService', ['api', function (api) {
   return {
-    // filter: { platform: 'all' | 'android' | 'ios', enrolled: boolean, search: string }
+    // filter: { platform: 'all' | 'android' | 'ios', enrolled: boolean,
+    //          compliance: 'all' | 'compliant' | 'non-compliant', search: string }
     list: function (filter) { return api.get('/devices', filter); },
     get: function (id) { return api.get('/devices/' + id); },
     moveToGroup: function (ids, groupId) { return api.post('/devices/move', { ids: ids, group: groupId }); },
