From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fixture Developer <dev@mobimanual.local>
Date: Thu, 8 Oct 2026 13:10:00 +0200
Subject: [PATCH] Remove the unreleased account expiry feature

Account expiry never left its flag: the customers who asked for it
manage expiry in their directory, and nobody else wanted it. The flag,
the field in the Add user form and its labels are removed.
---
Expected: not worth documenting. Triage answers no-doc-impact: the feature was never switched on, so the manual never described it and no reader loses anything. A removal that looks like it takes a field away from users.
Expected-outcome: no-doc-impact

 public/app/features.js      | 1 -
 public/app/users/users.html | 6 ------
 public/i18n/de.json         | 2 --
 public/i18n/en.json         | 2 --
 public/i18n/tr.json         | 2 --
 5 files changed, 13 deletions(-)

diff --git a/public/app/features.js b/public/app/features.js
index 2fb2293..ea20d5c 100644
--- a/public/app/features.js
+++ b/public/app/features.js
@@ -5,7 +5,6 @@
 
 angular.module('mobivisor')
   .constant('FEATURES', {
-    accountExpiry: false
   })
   .run(['$rootScope', 'FEATURES', function ($rootScope, FEATURES) {
     $rootScope.FEATURES = FEATURES;
diff --git a/public/app/users/users.html b/public/app/users/users.html
index 62adcf5..dfba429 100644
--- a/public/app/users/users.html
+++ b/public/app/users/users.html
@@ -35,12 +35,6 @@
     <label for="role">{{ 'USERS.ROLE' | translate }}</label>
     <select id="role" ng-model="draft.role" ng-options="role as ('USERS.ROLE_' + role.toUpperCase() | translate) for role in roles" required></select>
 
-    <div ng-if="FEATURES.accountExpiry">
-      <label for="expires">{{ 'USERS.ACCOUNT_EXPIRES' | translate }}</label>
-      <input id="expires" type="date" ng-model="draft.expires">
-      <p class="hint">{{ 'USERS.ACCOUNT_EXPIRES_HINT' | translate }}</p>
-    </div>
-
     <button type="submit" ng-disabled="addUser.$invalid">{{ 'COMMON.SAVE' | translate }}</button>
   </form>
 
