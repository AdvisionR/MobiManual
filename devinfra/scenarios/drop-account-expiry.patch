+++ b/public/i18n/de.json
@@ -132,8 +132,6 @@
     "ROLE_ADMINISTRATOR": "Administrator",
     "ROLE_HELPDESK": "Helpdesk",
     "ROLE_AUDITOR": "Auditor",
-    "ACCOUNT_EXPIRES": "Konto läuft ab",
-    "ACCOUNT_EXPIRES_HINT": "Optional. Ab diesem Datum kann sich das Konto nicht mehr an der Konsole anmelden. Vom Benutzer registrierte Geräte bleiben verwaltet.",
     "DISABLE": "Deaktivieren",
     "ENABLE": "Aktivieren",
     "RESET_PASSWORD": "Passwort zurücksetzen",
