diff --git a/public/app/devices/command-history.component.js b/public/app/devices/command-history.component.js
new file mode 100644
index 0000000..95db20f
--- /dev/null
+++ b/public/app/devices/command-history.component.js
@@ -0,0 +1,33 @@
+// The command history of one device, a page at a time (server/commands/history.js).
+// An expired command can be queued again from its row.
+
+angular.module('mobivisor').component('commandHistory', {
+  templateUrl: 'app/devices/command-history.html',
+  bindings: { deviceId: '<', onChange: '&' },
+  controller: ['commandService', function (commandService) {
+    var ctrl = this;
+    ctrl.page = 1;
+
+    ctrl.load = function (page) {
+      ctrl.loading = true;
+      return commandService.history(ctrl.deviceId, page).then(function (result) {
+        ctrl.commands = result.items;
+        ctrl.page = result.page;
+        ctrl.pages = result.pages;
+      }).finally(function () {
+        ctrl.loading = false;
+      });
+    };
+
+    ctrl.resend = function (command) {
+      return commandService.resend(command.id).then(function () {
+        ctrl.onChange();
+        return ctrl.load(ctrl.page);
+      });
+    };
+
+    ctrl.$onChanges = function () {
+      if (ctrl.deviceId) ctrl.load(1);
+    };
+  }]
+});
