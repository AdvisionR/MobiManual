+++ b/server/commands/command-queue.js
@@ -1,6 +1,6 @@
 // Commands wait here until the device checks in and acknowledges them. One the
 // device has not acknowledged in time is marked expired; the console can queue
-// it again (Retry).
+// it again (resend).
 
 const EXPIRY_HOURS = 24;
 
@@ -23,4 +23,11 @@ function pendingFor(db, deviceId) {
   return db.commands.find({ device: deviceId, state: 'queued' });
 }
 
-module.exports = { enqueue, expire, pendingFor, EXPIRY_HOURS };
+// Queues an expired command again, as a new command with the same content.
+function resend(db, commandId, sentBy, now) {
+  const old = db.commands.findOne({ _id: commandId, state: 'expired' });
+  if (!old) return null;
+  return enqueue(db, old.device, old.command, sentBy, now);
+}
+
+module.exports = { enqueue, expire, pendingFor, resend, EXPIRY_HOURS };
diff --git a/server/commands/history.js b/server/commands/history.js
new file mode 100644
index 0000000..77f3d7a
--- /dev/null
+++ b/server/commands/history.js
@@ -0,0 +1,18 @@
+// A device's command history, newest first, a page at a time. The device detail
+// page used to load the whole history, which took seconds for devices with
+// thousands of commands.
+
+const PAGE_SIZE = 50;
+
+function page(db, deviceId, n) {
+  const total = db.commands.count({ device: deviceId });
+  const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
+  const current = Math.min(Math.max(1, n || 1), pages);
+  const items = db.commands.find({ device: deviceId })
+    .sort({ sentAt: -1 })
+    .skip((current - 1) * PAGE_SIZE)
+    .limit(PAGE_SIZE);
+  return { items: items, page: current, pages: pages };
+}
+
+module.exports = { page, PAGE_SIZE };
diff --git a/server/commands/history.spec.js b/server/commands/history.spec.js
new file mode 100644
index 0000000..c8613dd
--- /dev/null
+++ b/server/commands/history.spec.js
@@ -0,0 +1,24 @@
+const { page, PAGE_SIZE } = require('./history');
+
+function fakeDb(n) {
+  const rows = Array.from({ length: n }, (_, i) => ({ device: 'd1', sentAt: i }));
+  const cursor = (items) => ({
+    sort: () => cursor(items.slice().reverse()),
+    skip: (k) => cursor(items.slice(k)),
+    limit: (k) => items.slice(0, k)
+  });
+  return { commands: { count: () => n, find: () => cursor(rows) } };
+}
+
+describe('command history', function () {
+  it('pages newest first', function () {
+    const result = page(fakeDb(120), 'd1', 2);
+    expect(result.pages).toBe(3);
+    expect(result.items.length).toBe(PAGE_SIZE);
+    expect(result.items[0].sentAt).toBe(69);
+  });
+
+  it('clamps the page to the last one', function () {
+    expect(page(fakeDb(10), 'd1', 9).page).toBe(1);
+  });
+});
