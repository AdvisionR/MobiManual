diff --git a/server/audit/query.js b/server/audit/query.js
new file mode 100644
index 0000000..42fafe3
--- /dev/null
+++ b/server/audit/query.js
@@ -0,0 +1,23 @@
+// Builds the Audit Log query behind GET /api/audit and its CSV export.
+// ip takes one address or a CIDR range: 10.1.2.3 or 10.0.0.0/8.
+
+const ipaddr = require('ipaddr.js');
+
+function where(filter) {
+  const clause = {};
+  if (filter.user) clause.user = filter.user;
+  if (filter.action) clause.action = filter.action;
+  if (filter.from || filter.to) {
+    clause.time = {};
+    if (filter.from) clause.time.$gte = new Date(filter.from);
+    if (filter.to) clause.time.$lt = new Date(new Date(filter.to).getTime() + 24 * 60 * 60 * 1000);
+  }
+  if (filter.ip) {
+    const [address, bits] = filter.ip.split('/');
+    const parsed = ipaddr.parse(address);
+    clause.ip = bits ? { $inRange: [parsed.toString(), Number(bits)] } : parsed.toString();
+  }
+  return clause;
+}
+
+module.exports = { where };
diff --git a/server/audit/query.spec.js b/server/audit/query.spec.js
new file mode 100644
index 0000000..be01826
--- /dev/null
+++ b/server/audit/query.spec.js
@@ -0,0 +1,11 @@
+const { where } = require('./query');
+
+describe('audit query', function () {
+  it('matches one address', function () {
+    expect(where({ ip: '10.1.2.3' }).ip).toBe('10.1.2.3');
+  });
+
+  it('matches a range', function () {
+    expect(where({ ip: '10.0.0.0/8' }).ip).toEqual({ $inRange: ['10.0.0.0', 8] });
+  });
+});
