+<!-- #!/policies/wifi, WifiCtrl. Security types and their fields: server/policies/wifi.js. -->
+<form class="wifi-policy" ng-submit="save()">
+  <h1>{{ 'WIFI.TITLE' | translate }}</h1>
+
+  <label for="ssid">{{ 'WIFI.SSID' | translate }}</label>
+  <input id="ssid" ng-model="policy.ssid" required>
+
+  <label for="security">{{ 'WIFI.SECURITY' | translate }}</label>
+  <select id="security" ng-model="policy.security">
+    <option value="wpa2-personal">{{ 'WIFI.WPA2_PERSONAL' | translate }}</option>
+    <option value="wpa3-personal">{{ 'WIFI.WPA3_PERSONAL' | translate }}</option>
+    <option value="wpa2-enterprise">{{ 'WIFI.WPA2_ENTERPRISE' | translate }}</option>
+  </select>
+
+  <div ng-if="policy.security !== 'wpa2-enterprise'">
+    <label for="password">{{ 'WIFI.PASSWORD' | translate }}</label>
+    <input id="password" type="password" ng-model="policy.password" required>
+  </div>
+  <p class="hint" ng-if="policy.security === 'wpa2-enterprise'">{{ 'WIFI.ENTERPRISE_HINT' | translate }}</p>
+
+  <label><input type="checkbox" ng-model="policy.hidden"> {{ 'WIFI.HIDDEN' | translate }}</label>
+
+  <button type="submit">{{ 'COMMON.SAVE' | translate }}</button>
+</form>
