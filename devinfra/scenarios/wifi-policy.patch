diff --git a/server/policies/wifi.js b/server/policies/wifi.js
new file mode 100644
index 0000000..0556732
--- /dev/null
+++ b/server/policies/wifi.js
@@ -0,0 +1,20 @@
+// Wi-Fi policies. Personal networks share one password; Enterprise signs in
+// with the device owner's directory account, so it needs a directory under
+// Settings > Directory and a device with an owner.
+
+const SECURITY = ['wpa2-personal', 'wpa3-personal', 'wpa2-enterprise'];
+
+function check(policy) {
+  const problems = [];
+  if (!policy.ssid || policy.ssid.length > 32) problems.push('ssid');
+  if (SECURITY.indexOf(policy.security) < 0) problems.push('security');
+  if (policy.security !== 'wpa2-enterprise' && (!policy.password || policy.password.length < 8)) problems.push('password');
+  return problems;
+}
+
+function supports(policy, device) {
+  if (policy.security === 'wpa3-personal') return device.platform === 'ios' || device.osVersion >= 10;
+  return true;
+}
+
+module.exports = { SECURITY, check, supports };
